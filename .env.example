# Copy to .env and fill in. Never commit .env.
QUANTUM_API_KEY=
# Optional, for your OWN private server only: let callers run on hardware without pasting a key.
# Never set these on a public deployment.
ENABLE_HARDWARE=0
# Where the Next.js app finds the Qiskit server (default http://127.0.0.1:8000)
# QISKIT_API_URL=
